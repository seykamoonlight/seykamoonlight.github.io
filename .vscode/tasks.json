{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ouvrir l'éditeur",
      "type": "shell",
      "command": "open Galerie.app",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Publier",
      "type": "shell",
      "command": "bash publish.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Publier — essai à blanc",
      "type": "shell",
      "command": "bash publish.sh --dry-run",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
